{
  "$defs": {
    "AnalyzeOptions": {
      "additionalProperties": false,
      "description": "JSON sent beside the audio file. A transcript matching a library text selects the\ncontrast mode, anything else selects the normative mode.",
      "properties": {
        "library_text_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transcript": {
          "minLength": 1,
          "type": "string"
        },
        "weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RubricWeights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "transcript",
        "library_text_id",
        "weights"
      ],
      "title": "AnalyzeOptions",
      "type": "object"
    },
    "AudioFile": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "description": "Time in seconds.",
          "exclusiveMinimum": 0,
          "minimum": 0,
          "type": "number"
        },
        "path": {
          "description": "Forward-slash path relative to the dataset root.",
          "minLength": 1,
          "type": "string"
        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "duration_s",
        "sample_rate_hz"
      ],
      "title": "AudioFile",
      "type": "object"
    },
    "Axis": {
      "description": "The four delivery axes a judge scores.",
      "enum": [
        "cadence",
        "tone",
        "pauses",
        "volume"
      ],
      "title": "Axis",
      "type": "string"
    },
    "AxisScore": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "score": {
          "description": "Score from 0 to 100.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "axis",
        "score",
        "weight"
      ],
      "title": "AxisScore",
      "type": "object"
    },
    "BandExpected": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "band",
          "default": "band",
          "type": "string"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        }
      },
      "required": [
        "basis",
        "low",
        "high"
      ],
      "title": "BandExpected",
      "type": "object"
    },
    "BandReference": {
      "additionalProperties": false,
      "properties": {
        "bands_version": {
          "type": "string"
        },
        "basis": {
          "const": "band",
          "default": "band",
          "type": "string"
        },
        "n_reference_clips": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "basis",
        "n_reference_clips",
        "bands_version"
      ],
      "title": "BandReference",
      "type": "object"
    },
    "BandSeries": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "band",
          "default": "band",
          "type": "string"
        },
        "high": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "low": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "basis",
        "low",
        "high"
      ],
      "title": "BandSeries",
      "type": "object"
    },
    "BaselineExpected": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "baseline",
          "default": "baseline",
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "basis",
        "value"
      ],
      "title": "BaselineExpected",
      "type": "object"
    },
    "BaselineReference": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "baseline",
          "default": "baseline",
          "type": "string"
        },
        "clip_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "text_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "warp": {
          "items": {
            "$ref": "#/$defs/WarpAnchor"
          },
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "basis",
        "clip_id",
        "text_id",
        "warp"
      ],
      "title": "BaselineReference",
      "type": "object"
    },
    "BaselineSeries": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "baseline",
          "default": "baseline",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "basis",
        "values"
      ],
      "title": "BaselineSeries",
      "type": "object"
    },
    "Category": {
      "description": "Competition category. Extemporaneous has no fixed text, so it never has a flawed mirror.",
      "enum": [
        "interpretive_reading",
        "declamation",
        "persuasive_oratory",
        "extemporaneous"
      ],
      "title": "Category",
      "type": "string"
    },
    "ClipLabel": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/WordAlignment"
        },
        "audio": {
          "$ref": "#/$defs/AudioFile"
        },
        "baseline_clip_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flaws": {
          "items": {
            "$ref": "#/$defs/FlawLabel"
          },
          "type": "array"
        },
        "id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "pipeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineStamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/ClipRole"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_sex": {
          "$ref": "#/$defs/Sex"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "text_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text_id",
        "role",
        "split",
        "speaker_sex",
        "audio",
        "alignment",
        "baseline_clip_id",
        "source_id",
        "pipeline",
        "flaws"
      ],
      "title": "ClipLabel",
      "type": "object"
    },
    "ClipRole": {
      "enum": [
        "gold",
        "control",
        "flawed",
        "natural_reader",
        "speaker_shifted",
        "human_clean",
        "human_flawed",
        "normative_reference"
      ],
      "title": "ClipRole",
      "type": "string"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "clips": {
          "items": {
            "$ref": "#/$defs/ClipLabel"
          },
          "type": "array"
        },
        "dataset_version": {
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRecord"
          },
          "type": "array"
        },
        "texts": {
          "items": {
            "$ref": "#/$defs/TextRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "dataset_version",
        "sources",
        "texts",
        "clips"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "DemoClip": {
      "additionalProperties": false,
      "description": "A dataset clip a visitor can analyze without recording anything. The true flaws are\nlisted so the demo can show the detector against a known answer.",
      "properties": {
        "audio_url": {
          "type": "string"
        },
        "clip_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "flaw_kinds": {
          "items": {
            "$ref": "#/$defs/FlawKind"
          },
          "type": "array"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "text_id",
        "title",
        "description",
        "audio_url",
        "flaw_kinds",
        "level"
      ],
      "title": "DemoClip",
      "type": "object"
    },
    "Deviation": {
      "additionalProperties": false,
      "description": "The measured gap behind a flaw.\n\n`delta` is observed minus the baseline value, or the signed distance outside the nearest\nband edge. `z_score` is that gap in units of the reference's own variability.",
      "properties": {
        "delta": {
          "type": "number"
        },
        "expected": {
          "discriminator": {
            "mapping": {
              "band": "#/$defs/BandExpected",
              "baseline": "#/$defs/BaselineExpected"
            },
            "propertyName": "basis"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BaselineExpected"
            },
            {
              "$ref": "#/$defs/BandExpected"
            }
          ]
        },
        "feature": {
          "$ref": "#/$defs/FeatureName"
        },
        "observed": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "z_score": {
          "type": "number"
        }
      },
      "required": [
        "feature",
        "unit",
        "observed",
        "expected",
        "delta",
        "z_score"
      ],
      "title": "Deviation",
      "type": "object"
    },
    "DoneEvent": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/Report"
        },
        "type": {
          "const": "done",
          "default": "done",
          "type": "string"
        }
      },
      "required": [
        "type",
        "job_id",
        "report"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "DragParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "drag",
          "default": "drag",
          "type": "string"
        },
        "rate_factor": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "rate_factor"
      ],
      "title": "DragParams",
      "type": "object"
    },
    "EnergyFadeParams": {
      "additionalProperties": false,
      "properties": {
        "drop_db": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "fade_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "kind": {
          "const": "energy_fade",
          "default": "energy_fade",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "drop_db",
        "fade_fraction"
      ],
      "title": "EnergyFadeParams",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "unsupported_audio",
        "too_long",
        "too_large",
        "transcript_mismatch",
        "alignment_failed",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "quoted_text": {
          "type": "string"
        }
      },
      "required": [
        "headline",
        "detail",
        "quoted_text"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "FailedEvent": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "job_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "const": "failed",
          "default": "failed",
          "type": "string"
        }
      },
      "required": [
        "type",
        "job_id",
        "code",
        "message"
      ],
      "title": "FailedEvent",
      "type": "object"
    },
    "FeatureName": {
      "description": "Time-series features rendered in the overlay and used as flaw evidence.",
      "enum": [
        "speech_rate",
        "pitch",
        "pitch_variation",
        "energy",
        "pause",
        "clarity"
      ],
      "title": "FeatureName",
      "type": "string"
    },
    "FlawKind": {
      "enum": [
        "rush",
        "drag",
        "monotone",
        "hesitation",
        "pause_collapse",
        "energy_fade"
      ],
      "title": "FlawKind",
      "type": "string"
    },
    "FlawLabel": {
      "additionalProperties": false,
      "description": "A ground-truth flaw region. `injection` is set for DSP clips and absent for human ones.",
      "properties": {
        "end": {
          "description": "Time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "injection": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "drag": "#/$defs/DragParams",
                  "energy_fade": "#/$defs/EnergyFadeParams",
                  "hesitation": "#/$defs/HesitationParams",
                  "monotone": "#/$defs/MonotoneParams",
                  "pause_collapse": "#/$defs/PauseCollapseParams",
                  "rush": "#/$defs/RushParams"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RushParams"
                },
                {
                  "$ref": "#/$defs/DragParams"
                },
                {
                  "$ref": "#/$defs/MonotoneParams"
                },
                {
                  "$ref": "#/$defs/HesitationParams"
                },
                {
                  "$ref": "#/$defs/PauseCollapseParams"
                },
                {
                  "$ref": "#/$defs/EnergyFadeParams"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/FlawKind"
        },
        "level": {
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer"
        },
        "start": {
          "description": "Time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "words": {
          "$ref": "#/$defs/WordSpan"
        }
      },
      "required": [
        "kind",
        "level",
        "start",
        "end",
        "words",
        "injection"
      ],
      "title": "FlawLabel",
      "type": "object"
    },
    "FlawRegion": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "deviation": {
          "$ref": "#/$defs/Deviation"
        },
        "end": {
          "description": "Time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FlawKind"
        },
        "severity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "start": {
          "description": "Time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "words": {
          "$ref": "#/$defs/WordSpan"
        }
      },
      "required": [
        "id",
        "kind",
        "axis",
        "start",
        "end",
        "words",
        "severity",
        "deviation",
        "explanation"
      ],
      "title": "FlawRegion",
      "type": "object"
    },
    "HesitationParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hesitation",
          "default": "hesitation",
          "type": "string"
        },
        "silences": {
          "items": {
            "$ref": "#/$defs/InsertedSilence"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "silences"
      ],
      "title": "HesitationParams",
      "type": "object"
    },
    "InsertedSilence": {
      "additionalProperties": false,
      "properties": {
        "after_word": {
          "description": "Zero-based index into a word alignment.",
          "minimum": 0,
          "type": "integer"
        },
        "duration_s": {
          "description": "Time in seconds.",
          "exclusiveMinimum": 0,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "after_word",
        "duration_s"
      ],
      "title": "InsertedSilence",
      "type": "object"
    },
    "JobCreated": {
      "additionalProperties": false,
      "description": "The response to `POST /api/jobs`. Events arrive on `GET /api/jobs/{job_id}/events`.",
      "properties": {
        "job_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "JobCreated",
      "type": "object"
    },
    "LibraryEntry": {
      "additionalProperties": false,
      "description": "A speech the participant can read and be compared against.",
      "properties": {
        "baseline_audio_url": {
          "type": "string"
        },
        "baseline_clip_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "duration_s": {
          "description": "Time in seconds.",
          "exclusiveMinimum": 0,
          "minimum": 0,
          "type": "number"
        },
        "text_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        }
      },
      "required": [
        "text_id",
        "title",
        "category",
        "transcript",
        "baseline_clip_id",
        "baseline_audio_url",
        "duration_s"
      ],
      "title": "LibraryEntry",
      "type": "object"
    },
    "LibraryListing": {
      "additionalProperties": false,
      "description": "The response to `GET /api/library`.",
      "properties": {
        "demos": {
          "items": {
            "$ref": "#/$defs/DemoClip"
          },
          "type": "array"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/LibraryEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries",
        "demos"
      ],
      "title": "LibraryListing",
      "type": "object"
    },
    "License": {
      "enum": [
        "public-domain-mark",
        "cc0",
        "us-government-work",
        "cc-by-4.0",
        "original-recording"
      ],
      "title": "License",
      "type": "string"
    },
    "ModelStamp": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision"
      ],
      "title": "ModelStamp",
      "type": "object"
    },
    "MonotoneParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "monotone",
          "default": "monotone",
          "type": "string"
        },
        "pitch_excursion_retained": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "pitch_excursion_retained"
      ],
      "title": "MonotoneParams",
      "type": "object"
    },
    "OverlaySeries": {
      "additionalProperties": false,
      "description": "One feature on the participant's clock, with what was expected drawn beside it.",
      "properties": {
        "expected": {
          "discriminator": {
            "mapping": {
              "band": "#/$defs/BandSeries",
              "baseline": "#/$defs/BaselineSeries"
            },
            "propertyName": "basis"
          },
          "oneOf": [
            {
