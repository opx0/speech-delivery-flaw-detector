# Optional native settings. Load these in your shell as described in docs/LOCAL_SETUP.md.
# Docker Compose uses PORT for its host port; container paths are set in compose.yml.
PORT=8000
DATA=data/dataset
TORCH_HOME=models/torch
UV_CACHE_DIR=.cache/uv

# Vite development proxies API requests here. Production uses same-origin requests.
SPEECH_API_URL=http://127.0.0.1:8000
